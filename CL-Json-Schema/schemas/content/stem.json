{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/content/stem.json",
  "title": "Stem",
  "description": "A stem within a task",
  "type": "object",
  "properties": {
    "id": {
    "$ref": "../common/primitives.json#/definitions/UUID"
    },
    "taskId": {
      "$ref": "../common/primitives.json#/definitions/UUID",
      "description": "Reference to the parent task"
    },
    "stemType": {
      "$ref": "../common/enums.json#/definitions/StemType",
      "description": "Type of stem (COMPLETION, CALCULATION, WORD_PROBLEM, etc.)"
    },
    "ancillaryText": {
      "type": "string",
      "description": "Text used in the stem not related to the question or prompt, such as names in an analysis question"
    },
    "stemText": {
      "type": "string",
      "description": "Stem text or question prompt"
    },
    "image": {
      "$ref": "../common/primitives.json#/definitions/UUID",
      "description": "Reference to the image used in this stem"
    },
    "responseArea": {
      "$ref": "../common/primitives.json#/definitions/UUID",
      "description": "Reference to the response area for this task"
    }
  },
  "required": ["id", "stemType", "taskId"]
}
